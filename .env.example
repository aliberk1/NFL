# These are examples. Set environment variables in PowerShell; no automatic .env loading.
NFL_LLM_API_KEY=
NFL_LLM_MODEL=
NFL_LLM_BASE_URL=https://api.openai.com/v1
# Use max_completion_tokens if the selected model rejects max_tokens.
NFL_LLM_MAX_TOKENS_FIELD=max_tokens
NFL_LLM_MAX_OUTPUT_TOKENS=4000
NFL_LLM_DAILY_TOKEN_LIMIT=500000
NFL_CHAT_PER_MINUTE=5
NFL_CHAT_GLOBAL_PER_MINUTE=20
NFL_CHAT_DAILY_LIMIT=200
